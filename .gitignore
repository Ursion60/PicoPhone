# Produits de compilation : régénérés par tools/build_sim.sh / build_firmware.sh
build/micropython/ports/*/build-*/
build/micropython/mpy-cross/build/

# Bytecode Python (CPython) généré à l'exécution des outils
__pycache__/
*.pyc

# Environnement Python local créé par tools/setup-deps.sh tools
.venv/

# Données de l'appli EDT envoyées par tools/sync_pronote.py (jamais versionnées)
python/edt/

# Synchro Pronote : le JSON d'un QR code contient un jeton, et les identifiants ne doivent jamais être commités
qr*.json
pronote*.json
edt_out/
